;
; bot-api.scm
;
; Top-level Eva chatbot API.
; Its a modified fork of ../chatbot/bot-api.scm
;
; Eva's verbal replies are always generated by the language model (see
; `eva-model/llm.scm`).  The language-analysis code here only
; supplies the model with grounded facts: the speech-act type, any
; actions that were actually performed, and any self-model facts that
; answer a question.  If the model fails, Eva says nothing and the
; error is logged.

(use-modules (opencog nlp))
(use-modules (opencog eva-model)) ; for eva-model-utterance

;--------------------------------------------------------------------

;; XXX FIXME this is a cut-n-paste job from process-query

(define-public (grounded-talk USER QUERY)
"
  grounded-talk USER QUERY -- accept USER's text and perform action,
  and print a reply generated by the language model.

  This is a truncated chatbot interface, for use with the robot.
  It accepts an utterance (in the form of a text string) and, if it is
  understood, then the robot performs an action.
  The USER is the user-name  The QUERY is the string holding what the
  user said.
"
    ; nlp-parse returns (SentenceNode "sentence@45c470a6-29...")
    (define sent-node (car (nlp-parse QUERY)))

    ; Call the `get-utterance-type` function to get the speech act type
    ; of the utterance.  The grounding performed depends on the type
    ; of the speech act.
    ;
    ; XXX Currently, this dispatch is done via scheme code below. The
    ; correct design would use an ImplicationLink to match up the
    ; speech-act type to the processing that would be performed.  This
    ; would allow a single sentence to be interpreted as possibly several
    ; different speech-act types.  It would fit better into the long-term
    ; plan to do all recognition with ImplicationLinks+ure.
    (define gutr (sentence-get-utterance-type sent-node))
    (define utr (if (equal? '() gutr) '() (car gutr)))

    (define grounding
        (cond
            ((equal? utr (DefinedLinguisticConceptNode "TruthQuerySpeechAct"))
                "This is a yes/no question. You have no grounded facts about it.")
            ((equal? utr (DefinedLinguisticConceptNode "InterrogativeSpeechAct"))
                (let ((facts (self-wh-query sent-node)))
                    (if (null? facts)
                        "This is a question. Your self-model has no facts that answer it."
                        (string-append
                            "This is a question. Facts from your self-model that answer it:\n"
                            (string-join facts "\n")))))
            ((equal? utr (DefinedLinguisticConceptNode "DeclarativeSpeechAct"))
                "This is a statement.")
            ((equal? utr (DefinedLinguisticConceptNode "ImperativeSpeechAct"))
                ; Make the robot do whatever ...
                (let ((done (imperative-process sent-node)))
                    (if (null? done)
                        "This is a command. You did not recognise any action you can perform for it, so you did nothing."
                        (string-append
                            "This is a command. You have just performed these actions:\n"
                            (string-join done "\n")))))
            (else
                "The speech-act type of this utterance could not be identified.")))

    (catch #t
        (lambda ()
            (display
                (eva-model-utterance
                    (format #f "~a says to you: ~s\n~a"
                        USER QUERY grounding)))
            (newline))
        (lambda (key . args)
            (eva-model-log-error "chatbot reply" key args)))
    *unspecified*)
